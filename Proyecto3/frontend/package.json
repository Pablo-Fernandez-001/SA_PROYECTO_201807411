{
  "name": "delivereats-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:evidence": "cypress run --spec cypress/e2e/frontend-evidence.cy.js",
    "cypress:run:full-flow": "cypress run --spec cypress/e2e/auth-roles-flow.cy.js,cypress/e2e/client-full-flow.cy.js,cypress/e2e/admin-full-flow.cy.js,cypress/e2e/restaurant-full-flow.cy.js,cypress/e2e/courier-full-flow.cy.js",
    "test:e2e:evidence": "start-server-and-test dev http://127.0.0.1:3000 cypress:run:evidence",
    "test:e2e:full-flow": "start-server-and-test dev http://127.0.0.1:3000 cypress:run:full-flow",
    "test:e2e:all": "start-server-and-test dev http://127.0.0.1:3000 cypress:run",
    "test:e2e:refresh-evidence": "npm run test:e2e:full-flow && npm run test:e2e:evidence"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.8.0",
    "socket.io-client": "^4.7.4",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "cypress": "^15.14.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "start-server-and-test": "^3.0.2",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  }
}
